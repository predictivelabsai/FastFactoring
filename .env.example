DB_URL=postgresql://user:pass@localhost:5432/fastfactoring
# Production runtime prefers this URL when set.
DATABASE_URL_PROD=
APP_SECRET=change-me-to-a-random-string
ADMIN_PASSWORD=
APP_ENV=dev
PORT=5055

# Google OpenID Connect. Keep secrets in ignored/local or runtime environment files.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://factorio.co.uk/auth/google/callback
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_ALLOWED_EMAILS=

# AI — Grok via x.ai (powers /app/triage and /app/assistant). Optional:
# the assistants degrade gracefully when XAI_API_KEY is unset.
XAI_API_KEY=
XAI_MODEL=grok-4.3
XAI_BASE_URL=https://api.x.ai/v1

# Companies House enrichment for UK supplier registration follow-up.
CH_API_KEY=
